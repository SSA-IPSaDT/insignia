{
    "name": "insignia",
    "version": "0.1.0",
    "description": "Insignia — модульная монорепозиторная платформа (Svelte 5, REST API, Bot, Contracts, Database)",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "author": {
        "name": "naylour",
        "email": "naylour@tuta.io",
        "url": "https://github.com/naylour"
    },
    "contributors": [
