            "name": "naylour",
            "email": "naylour@tuta.io",
            "url": "https://github.com/naylour"
        },
        {
            "name": "segn1s",
            "email": "delissat3@gmail.com",
            "url": "https://github.com/segn1s"
        },
        {
            "name": "sasadobryi12-code",
            "email": "sasadobryi12@gmail.com",
            "url": "https://github.com/sasadobryi12-code"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/SSA-IPSaDT/insignia.git"
    },
    "bugs": {
        "url": "https://github.com/SSA-IPSaDT/insignia/issues"
    },
    "homepage": "https://github.com/SSA-IPSaDT/insignia#readme",
    "keywords": [
        "monorepo",
        "bun",
        "moonrepo",
        "svelte",
        "sveltekit",
        "typescript",
        "admin",
        "api",
        "bot",
        "contracts",
        "database"
    ],
    "workspaces": [
        "apps/*",
        "packages/*",
        "infra/env"
    ],
    "catalog": {
        "@types/bun": "^1.4.4",
        "temporal-polyfill": "^1.0.8",
        "typescript": "^7.0.2",
        "zod": "^4.6.7"
    },
    "catalogs": {
        "server": {
            "elysia": "^1.4.30"
        },
        "web": {
            "@lucide/svelte": "^1.72.0",
            "@sveltejs/adapter-bun": "^1.0.1",
            "@sveltejs/kit": "^3.2.0",
            "@sveltejs/vite-plugin-svelte": "^7.2.0",
            "@tailwindcss/forms": "^0.5.11",
            "@tailwindcss/typography": "^0.5.19",
            "@tailwindcss/vite": "^4.3.5",
            "@typescript/native": "npm:typescript@^7.0.2",
            "@typescript/tsserver": "npm:typescript@^6.0.3",
            "mdsvex": "^0.12.8",
            "mode-watcher": "^1.1.0",
            "svelte": "^5.57.2",
            "svelte-check": "^4.7.8",
            "svelte-sonner": "^1.2.3",
            "tailwindcss": "^4.3.5",
            "typescript": "^6.0.3",
            "vite": "^8.3.8"
        }
    },
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "fnox exec -- moon run app:dev",
        "dev:all": "fnox exec -- moon run :dev",
        "dev:admin": "fnox exec -- moon run admin:dev",
        "dev:api": "fnox exec -- moon run api:dev",
        "dev:bot": "fnox exec -- moon run bot:dev",
        "dev:app": "fnox exec -- moon run app:dev",
        "build": "fnox exec -- moon run :build",
        "typecheck": "moon run :check",
        "check": "moon run :check",
        "test": "fnox exec -- bun test",
        "test:moon": "fnox exec -- moon run :test",
        "fmt": "bun fmt",
        "fmt:check": "bun fmt --check",
        "hk:check": "hk check",
        "hk:install": "hk install",
        "setup": "bun run scripts/setup.ts",
        "create-key": "bun run scripts/create-key.ts",
        "fnox:set": "bun run scripts/fnox-set.ts",
        "compose:up": "fnox exec -- docker compose up -d",
        "compose:down": "docker compose down",
        "compose:stop": "docker compose stop",
        "compose:restart": "fnox exec -- docker compose restart",
        "compose:logs": "docker compose logs -f",
        "db:init": "fnox exec -- moon run database:db-init",
        "db:skills": "bun x --cwd packages/database prisma skills sync"
    },
    "devDependencies": {
        "@types/bun": "catalog:",
        "@typescript/tsserver": "catalog:web",
        "typescript": "catalog:"
    },
    "dependencies": {}
}
