{
    "name": "insignia",
    "version": "0.1.0",
    "description": "Insignia — модульная монорепозиторная платформа (Svelte 5, REST API, Bot, Contracts, Database)",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "author": "naylour",
    "contributors": [
        {
            "name": "naylour"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/organization/insignia.git"
    },
    "bugs": {
        "url": "https://github.com/organization/insignia/issues"
    },
    "homepage": "https://github.com/organization/insignia#readme",
    "keywords": [
        "monorepo",
        "bun",
        "moonrepo",
        "svelte",
        "sveltekit",
        "typescript",
        "api",
        "bot",
        "contracts",
        "database"
    ],
    "workspaces": [
        "apps/*",
        "packages/*",
        "infra/env"
    ],
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "moon run :dev",
        "build": "moon run :build",
        "typecheck": "bun check",
        "check": "bun check",
        "fmt": "bun fmt",
        "fmt:check": "bun fmt --check",
        "hk:check": "hk check",
        "hk:install": "hk install",
        "create-key": "bun run scripts/create-key.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    }
}
