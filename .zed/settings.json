{
    "tab_size": 4,
    "hard_tabs": false,
    "format_on_save": "on",
    "languages": {
        "TypeScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "TSX": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JavaScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JSON": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "Markdown": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "HTML": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "CSS": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "Prisma": {
            "format_on_save": "on",
            "tab_size": 4,
            "hard_tabs": false
        }
    },
    "lsp": {
        "prisma-language-server": {
            "settings": {
                "prisma": {
                    // "auto" (по умолчанию), "prisma8" или "legacy"
                    "serverMode": "prisma8",
                    // Для проектов на Prisma 6 (в legacy режиме)
                    "pinToPrisma6": false,
                    // Включение/отключение диагностики
                    "enableDiagnostics": true
                }
            }
        }
    }
}
