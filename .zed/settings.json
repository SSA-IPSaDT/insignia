{
    "tab_size": 4,
    "hard_tabs": false,
    "format_on_save": "on",
    "languages": {
        "TypeScript": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
