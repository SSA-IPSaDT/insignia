{
    "tab_size": 4,
    "hard_tabs": false,
    "format_on_save": "on",
    "file_scan_exclusions": [
        "**/node_modules",
        "**/.moon",
        "**/.svelte-kit",
        "**/build",
        "**/dist",
        "**/logs",
        "**/coverage",
        "**/*.tsbuildinfo",
        "**/old",
        "..."
    ],
    "languages": {
        "TypeScript": {
            "format_on_save": "on",
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "..."
            ],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "TSX": {
            "format_on_save": "on",
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "..."
            ],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JavaScript": {
            "format_on_save": "on",
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "..."
            ],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JSON": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "Markdown": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "HTML": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "CSS": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "Prisma": {
            "format_on_save": "on",
            "tab_size": 4,
            "hard_tabs": false
        },
        "JSX": {
            "format_on_save": "on",
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "..."
            ],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "Svelte": {
            "tab_size": 4,
            "hard_tabs": false,
            "format_on_save": "on",
            "language_servers": [
                "svelte-language-server",
                "tailwindcss-language-server",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "..."
            ],
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "YAML": {
            "tab_size": 2,
            "hard_tabs": false,
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "bun",
                    "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
                }
            }
        }
    },
    "lsp": {
        "typescript-ls": {
            "settings": {
                "typescript": {
                    "preferences": {
                        "quoteStyle": "single",
                        "preferTypeOnlyAutoImports": true,
                        "autoImportFileExcludePatterns": [
                            "**/node_modules/.bun/**",
                            "**/.svelte-kit/**",
                            "**/build/**",
                            "**/dist/**",
                            "**/.moon/**",
                            "**/logs/**",
                            "**/old/**"
                        ]
                    },
                    "workspaceSymbols": {
                        "excludeLibrarySymbols": true
                    }
                },
                "javascript": {
                    "preferences": {
                        "quoteStyle": "single",
                        "preferTypeOnlyAutoImports": true,
                        "autoImportFileExcludePatterns": [
                            "**/node_modules/.bun/**",
                            "**/.svelte-kit/**",
                            "**/build/**",
                            "**/dist/**",
                            "**/.moon/**",
                            "**/logs/**",
                            "**/old/**"
                        ]
                    },
                    "workspaceSymbols": {
                        "excludeLibrarySymbols": true
                    }
                }
            }
        },
        "svelte-language-server": {
            "settings": {
                "typescript": {
                    "preferences": {
                        "quoteStyle": "single",
                        "preferTypeOnlyAutoImports": true,
                        "includePackageJsonAutoImports": "off",
                        "autoImportFileExcludePatterns": [
                            "**/node_modules/.bun/**",
                            "**/.svelte-kit/**",
                            "**/build/**",
                            "**/dist/**",
                            "**/.moon/**",
                            "**/logs/**",
                            "**/old/**"
                        ]
                    }
                },
                "javascript": {
                    "preferences": {
                        "quoteStyle": "single",
                        "preferTypeOnlyAutoImports": true,
                        "includePackageJsonAutoImports": "off",
                        "autoImportFileExcludePatterns": [
                            "**/node_modules/.bun/**",
                            "**/.svelte-kit/**",
                            "**/build/**",
                            "**/dist/**",
                            "**/.moon/**",
                            "**/logs/**",
                            "**/old/**"
                        ]
                    }
                }
            }
        },
        "tailwindcss-language-server": {
            "settings": {
                "tailwindCSS": {
                    "files": {
                        "exclude": [
                            "**/.git/**",
                            "**/node_modules/**",
                            "**/.moon/**",
                            "**/.svelte-kit/**",
                            "**/build/**",
                            "**/dist/**",
                            "**/logs/**",
                            "**/old/**"
                        ]
                    }
                }
            }
        },
        "vscode-css-language-server": {
            "settings": {
                "css": {
                    "lint": {
                        "unknownAtRules": "ignore"
                    }
                },
                "scss": {
                    "lint": {
                        "unknownAtRules": "ignore"
                    }
                },
                "less": {
                    "lint": {
                        "unknownAtRules": "ignore"
                    }
                }
            }
        },
        "prisma-language-server": {
            "settings": {
                "prisma": {
                    // "auto" (по умолчанию), "prisma8" или "legacy"
                    "serverMode": "prisma8",
                    // Для проектов на Prisma 6 (в legacy режиме)
                    "pinToPrisma6": false,
                    // Включение/отключение диагностики
                    "enableDiagnostics": true
                }
            }
        }
    }
}
