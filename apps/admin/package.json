{
    "name": "@insignia/admin",
    "version": "0.1.0",
    "description": "Панель администратора платформы Insignia на базе Svelte 5, SvelteKit и Tailwind CSS v4",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "author": {
        "name": "naylour",
        "email": "naylour@tuta.io",
        "url": "https://github.com/naylour"
    },
    "contributors": [
        {
            "name": "naylour",
            "email": "naylour@tuta.io",
            "url": "https://github.com/naylour"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/SSA-IPSaDT/insignia.git",
        "directory": "apps/admin"
    },
    "bugs": {
        "url": "https://github.com/SSA-IPSaDT/insignia/issues"
    },
    "homepage": "https://github.com/SSA-IPSaDT/insignia/tree/main/apps/admin#readme",
    "keywords": [
        "svelte",
        "sveltekit",
        "vite",
        "typescript",
        "insignia",
        "admin",
        "dashboard",
        "ui"
    ],
    "scripts": {
        "dev": "vite dev",
        "build": "bun --bun vite build",
        "preview": "vite preview",
        "prepare": "bun --bun svelte-kit sync || echo ''",
        "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "dependencies": {
        "@insignia/contracts": "workspace:*",
        "@insignia/env": "workspace:*",
        "@insignia/logger": "workspace:*",
        "@insignia/sdk": "workspace:*",
        "@lucide/svelte": "^1.70.0",
        "clsx": "^2.1.1",
        "lucide-svelte": "^1.0.1",
        "mode-watcher": "^1.1.0",
        "svelte-sonner": "^1.2.3",
        "tailwind-merge": "^3.7.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@insignia/tsconfig": "workspace:*",
        "@sveltejs/adapter-bun": "^1.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "mdsvex": "^0.12.7",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.6"
    },
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*",
        "#styles": "./src/lib/styles/index.css",
        "#styles/*": "./src/lib/styles/*",
        "#components": "./src/lib/components/index.ts",
        "#components/*": "./src/lib/components/*",
        "#sections": "./src/lib/sections/index.ts",
        "#sections/*": "./src/lib/sections/*"
    }
}
