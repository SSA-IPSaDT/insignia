{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@insignia/tsconfig/bun.json",
    "compilerOptions": {
        "paths": {
            "@plugins": ["./src/plugins/index.ts"],
            "@plugins/*": ["./src/plugins/*"],
            "@modules": ["./src/modules/index.ts"],
            "@modules/*": ["./src/modules/*"],
            "@common": ["./src/common/index.ts"],
            "@common/*": ["./src/common/*"]
        }
    },
    "include": ["src/**/*"]
}
