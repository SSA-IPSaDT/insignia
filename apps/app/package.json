            "email": "sasadobryi12@gmail.com",
            "url": "https://github.com/sasadobryi12-code"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/SSA-IPSaDT/insignia.git",
        "directory": "apps/app"
    },
    "bugs": {
        "url": "https://github.com/SSA-IPSaDT/insignia/issues"
    },
    "homepage": "https://github.com/SSA-IPSaDT/insignia/tree/main/apps/app#readme",
    "keywords": [
        "svelte",
        "sveltekit",
        "vite",
        "typescript",
        "insignia",
        "frontend",
        "ui"
    ],
    "scripts": {
        "dev": "bun --bun vite dev",
        "build": "bun --bun vite build",
        "preview": "bun --bun vite preview",
        "prepare": "bun --bun svelte-kit sync || echo ''",
        "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsgo --tsconfig ./tsconfig.json",
        "check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsgo --tsconfig ./tsconfig.json --watch"
    },
    "dependencies": {
        "@insignia/contracts": "workspace:*",
        "@insignia/env": "workspace:*",
        "@insignia/logger": "workspace:*",
        "@insignia/sdk": "workspace:*",
        "@tma.js/sdk": "^3.3.0",
        "@tma.js/sdk-svelte": "^1.0.23",
        "temporal-polyfill": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@insignia/tsconfig": "workspace:*",
        "@internationalized/date": "^3.12.0",
        "@lucide/svelte": "catalog:web",
        "@sveltejs/adapter-bun": "catalog:web",
        "@sveltejs/kit": "catalog:web",
        "@sveltejs/vite-plugin-svelte": "catalog:web",
        "@tailwindcss/vite": "catalog:web",
        "@typescript/native": "catalog:web",
        "bits-ui": "^2.20.0",
        "cn": "^0.5.0",
        "embla-carousel-svelte": "^8.6.0",
        "formsnap": "^2.1.0",
        "mdsvex": "catalog:web",
        "mode-watcher": "catalog:web",
        "shadcn-svelte": "^1.8.0",
        "svelte": "catalog:web",
        "svelte-check": "catalog:web",
        "svelte-sonner": "catalog:web",
        "sveltekit-superforms": "^3.0.0",
        "tailwind-variants": "^3.3.0",
        "tailwindcss": "catalog:web",
        "tw-animate-css": "^1.4.0",
        "typescript": "catalog:web",
        "vaul-svelte": "^1.0.0-next.7",
        "vite": "catalog:web"
    },
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*"
    }
}
